{
  "name": "retroflops",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm data:build && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:offline-check": "ASTRO_TELEMETRY_DISABLED=1 node --import ./scripts/lib/block-network.ts ./node_modules/astro/bin/astro.mjs build",
    "build:pages": "ASTRO_TELEMETRY_DISABLED=1 OUT_DIR=dist-pages BASE_PATH=/retroflops/ SITE_URL=https://example.github.io astro build",
    "budgets": "node scripts/check-budgets.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm brand:icons:check && pnpm data:normalize:check && pnpm data:validate && pnpm data:coverage && pnpm data:index:check && pnpm test && pnpm build && pnpm budgets",
    "data:build": "node scripts/data-build.ts",
    "data:extract-hash": "node scripts/data-extract-hash.ts",
    "data:fetch": "node scripts/data-fetch.ts",
    "data:gaps": "node scripts/data-gaps.ts && pnpm format",
    "data:image-gaps": "node scripts/data-image-gaps.ts && pnpm format",
    "data:images": "node scripts/data-images.ts",
    "data:images:check": "node scripts/data-images.ts --check",
    "data:index": "node scripts/data-index.ts",
    "data:index:check": "node scripts/data-index.ts --check",
    "data:links": "node scripts/check-links.ts",
    "data:normalize": "node scripts/data-normalize.ts",
    "data:normalize:check": "node scripts/data-normalize.ts --check",
    "data:report": "node scripts/data-report.ts",
    "data:validate": "node scripts/data-validate.ts",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "predev": "pnpm data:build",
    "format": "oxfmt . && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.astro\"",
    "lighthouse": "lhci autorun",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postbuild": "pagefind --site dist",
    "pretypecheck": "pnpm data:build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 node scripts/preview-server.ts",
    "preview:pages": "ASTRO_TELEMETRY_DISABLED=1 OUT_DIR=dist-pages BASE_PATH=/retroflops/ node scripts/preview-server.ts",
    "release": "node scripts/release.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "data:coverage": "node scripts/data-coverage.ts",
    "brand:icons": "node scripts/brand-icons.ts",
    "brand:icons:check": "node scripts/brand-icons.ts --check"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@observablehq/plot": "^0.6.17",
    "astro": "^7.3.2",
    "preact": "^10.29.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.82.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
