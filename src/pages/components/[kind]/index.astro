/**
 * A component category page.
 *
 * `/components/cpu/intel-8086/` resolved long before `/components/cpu/` did,
 * which made the middle of the path a hole a reader could fall into. The
 * breadcrumb needed this route anyway; it was a missing page before it was a
 * navigation feature.
 */
import ComponentCard from '~/components/component-card.astro';
import CategoryLayout from '~/layouts/category-layout.astro';
import { getComponentAvailability } from '~/lib/catalog';
import { COMPONENT_KINDS } from '~/lib/data/schema';
import type { Component } from '~/lib/data/schema';
import { componentKindLabel } from '~/lib/display';
import { componentCategory, componentsOfKind } from '~/lib/families';

export function getStaticPaths() {
  return COMPONENT_KINDS.map((kind) => ({ params: { kind }, props: { kind } }));
}

interface Props {
  kind: Component['kind'];
}

const { kind } = Astro.props;

const components = componentsOfKind(kind).filter(
  (component) => getComponentAvailability(component).availability === 'catalog',
);
const researchCount = componentsOfKind(kind).length - components.length;
const label = componentKindLabel(kind);

const crumbs = [
  { name: 'RetroFlops', path: '/' },
  { name: 'Explore', path: '/explore/' },
  componentCategory(kind),
];

const description = `Every ${label.toLowerCase()} record in the RetroFlops catalog, by name.`;
---

<CategoryLayout
  label={label}
  description={description}
  crumbs={crumbs}
  researchCount={researchCount}
  researchNoun={{ one: 'component is', other: 'components are' }}
>
  {components.map((component) => <ComponentCard component={component} />)}
</CategoryLayout>
