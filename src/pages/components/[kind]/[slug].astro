import ConflictsSection from '~/components/conflicts-section.astro';
import DerivedClaimsSection from '~/components/derived-claims-section.astro';
import EditorialNotes from '~/components/editorial-notes.astro';
import MeasurementTable from '~/components/measurement-table.astro';
import ProfileLayout from '~/layouts/profile-layout.astro';
import {
  getComponents,
  getComponentAvailability,
  getConflictsFor,
  getContextClaimsFor,
  getDerivedClaimsUsing,
  getMeasurementsFor,
  getSourcesByIds,
  getSystemsUsing,
} from '~/lib/catalog';
import { formatPartialDate, formatQuantity, humaniseIdentifier } from '~/lib/display';
import { componentCrumbs, componentFamilyNav } from '~/lib/families';
import { route } from '~/lib/paths';
import { componentArticle } from '~/lib/structured-data';

export function getStaticPaths() {
  return getComponents().map((component) => ({
    params: { kind: component.kind, slug: component.slug },
    props: { component },
  }));
}

const { component } = Astro.props;
const availability = getComponentAvailability(component);

const measurements = getMeasurementsFor('component', component.id);
const contextClaims = getContextClaimsFor('component', component.id);
const usedBy = getSystemsUsing(component.id);
const derivedClaims = getDerivedClaimsUsing(measurements.map((measurement) => measurement.id));
const conflicts = getConflictsFor('component', component.id);
const sources = getSourcesByIds([
  ...new Set([
    ...component.sourceIds,
    ...measurements.flatMap((measurement) => measurement.sourceIds),
    ...contextClaims.flatMap((claim) => claim.sourceIds),
  ]),
]);

const KIND_LABELS = { cpu: 'Processor', gpu: 'Graphics', memory: 'Memory' } as const;
---

<ProfileLayout
  record={component}
  path={`/components/${component.kind}/${component.slug}/`}
  research={availability.availability === 'research'}
  crumbs={componentCrumbs(component)}
  article={(absolute) => componentArticle(component, absolute)}
  sources={sources}
  familyNav={componentFamilyNav(component)}
>
  <Fragment slot="notice">
    <strong>Research record.</strong> The source trail is preserved, but no numeric measurement is currently
    available for this component or a system that uses it.
  </Fragment>

  <header class="page-header stack">
    <p class="page-header__eyebrow">{KIND_LABELS[component.kind]}</p>
    <h1>{component.name}</h1>
    <p class="lede prose">{component.summary}</p>
    <dl class="fact-row">
      <div>
        <dt>Manufacturer</dt>
        <dd>{component.manufacturer}</dd>
      </div>
      {
        component.architecture !== undefined && (
          <div>
            <dt>Architecture</dt>
            <dd>{component.architecture}</dd>
          </div>
        )
      }
      {
        component.introducedDate !== undefined && (
          <div>
            <dt>Introduced</dt>
            <dd>{formatPartialDate(component.introducedDate)}</dd>
          </div>
        )
      }
      {
        contextClaims.map((claim) => (
          <div>
            <dt>{claim.label}</dt>
            <dd class="numeric">{formatQuantity(claim.quantity).text}</dd>
          </div>
        ))
      }
      {
        component.kind === 'cpu' && component.instructionSet !== undefined && (
          <div>
            <dt>Instruction set</dt>
            <dd>{component.instructionSet}</dd>
          </div>
        )
      }
      {
        component.kind === 'memory' && component.memoryType !== undefined && (
          <div>
            <dt>Type</dt>
            <dd>{component.memoryType}</dd>
          </div>
        )
      }
      <div>
        <dt>Record status</dt>
        <dd>{component.editorialStatus}</dd>
      </div>
    </dl>
  </header>

  {
    measurements.length > 0 && (
      <section class="stack" aria-labelledby="figures">
        <h2 id="figures">Figures</h2>
        <MeasurementTable
          measurements={measurements}
          sources={sources}
          caption={`${component.name}: recorded figures`}
          openAbsences={availability.availability === 'research'}
        />
      </section>
    )
  }

  <DerivedClaimsSection claims={derivedClaims} heading="Derived comparisons" />

  <ConflictsSection conflicts={conflicts} sources={sources} />

  {
    usedBy.length > 0 && (
      <section class="stack" aria-labelledby="used-by">
        <h2 id="used-by">Fitted to</h2>
        <ul class="link-list">
          {usedBy.map((system) => (
            <li>
              <a href={route(`/systems/${system.slug}/`)}>{system.name}</a>
              <span class="meta">
                {humaniseIdentifier(system.type)} · {formatPartialDate(system.releaseDate)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <EditorialNotes notes={component.notes} />
</ProfileLayout>
