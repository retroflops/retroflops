import BaseLayout from '~/layouts/base-layout.astro';
import { route } from '~/lib/paths';
---

<BaseLayout title="Page not found" description="This RetroFlops page does not exist." noindex>
  <header class="page-header stack">
    <p class="page-header__eyebrow">Error 404</p>
    <h1>Page not found</h1>
    <p class="lede prose">
      That address does not match any system, component, source or section of this site.
    </p>
  </header>

  <p class="prose">
    Try the <a href={route('/explore/')}>catalog</a> or return to the
    <a href={route('/')}>home page</a>.
  </p>
</BaseLayout>
